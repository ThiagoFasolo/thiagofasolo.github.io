  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Chart 10: Top Performers Table and Summary\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "\n",
    "# Select funds with complete data\n",
    "complete_df = df.dropna(subset=[\n",
    "    'Annualized Returns (Since Inception)',\n",
    "    'Sharpe Ratio (Since Inception)',\n",
    "    'Sortino Ratio',\n",
    "    'Maximum Drawdown'\n",
    "]).copy()\n",
    "\n",
    "# Normalize metrics (0-1 scale)\n",
    "scaler = MinMaxScaler()\n",
    "complete_df['Returns_Norm'] = scaler.fit_transform(complete_df[['Annualized Returns (Since Inception)']])\n",
    "complete_df['Sharpe_Norm'] = scaler.fit_transform(complete_df[['Sharpe Ratio (Since Inception)']])\n",
    "complete_df['Sortino_Norm'] = scaler.fit_transform(complete_df[['Sortino Ratio']])\n",
    "# For drawdown, invert since lower (less negative) is better\n",
    "complete_df['Drawdown_Norm'] = 1 - scaler.fit_transform(complete_df[['Maximum Drawdown']].abs())\n",
    "\n",
    "# Composite score: weighted average\n",
    "complete_df['Composite_Score'] = (\n",
    "    complete_df['Returns_Norm'] * 0.25 +\n",
    "    complete_df['Sharpe_Norm'] * 0.30 +\n",
    "    complete_df['Sortino_Norm'] * 0.25 +\n",
    "    complete_df['Drawdown_Norm'] * 0.20\n",
    ")\n",
    "\n",
    "# Get top 20 funds\n",
    "top_funds = complete_df.nlargest(20, 'Composite_Score')[[\n",
    "    'Fund Name', 'Manager Name', 'Primary Strategy', 'Country',\n",
    "    'Annualized Returns (Since Inception)', 'Sharpe Ratio (Since Inception)',\n",
    "    'Sortino Ratio', 'Maximum Drawdown', 'Fund AuM (m)', 'Composite_Score'\n",
    "]].copy()\n",
    "\n",
    "# Round for display\n",
    "top_funds['Composite_Score'] = top_funds['Composite_Score'].round(3)\n",
    "top_funds['Annualized Returns (Since Inception)'] = top_funds['Annualized Returns (Since Inception)'].round(2)\n",
    "top_funds['Sharpe Ratio (Since Inception)'] = top_funds['Sharpe Ratio (Since Inception)'].round(2)\n",
    "top_funds['Sortino Ratio'] = top_funds['Sortino Ratio'].round(2)\n",
    "top_funds['Maximum Drawdown'] = top_funds['Maximum Drawdown'].round(2)\n",
    "top_funds['Fund AuM (m)'] = top_funds['Fund AuM (m)'].round(0)\n",
    "\n",
    "top_funds.index = range(1, len(top_funds) + 1)\n",
    "\n",
    "print(\"\\n\" + \"=\"*100)\n",
    "print(\"TOP 20 HEDGE FUNDS BY COMPOSITE PERFORMANCE SCORE\")\n",
    "print(\"=\"*100)\n",
    "print(\"\\nScoring Methodology: 25% Returns + 30% Sharpe + 25% Sortino + 20% Drawdown Protection\")\n",
    "print(\"\\nAll metrics normalized to 0-1 scale before weighting\\n\")\n",
    "\n",
    "top_funds"
